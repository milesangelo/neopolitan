{
  "name": "neopolitan-ai",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Provider-agnostic TypeScript SDK and CLI for coding-agent harnesses (Claude Code, Codex, ACP, PTY) — every flavor in one container.",
  "keywords": [
    "coding-agent",
    "ai-agent",
    "acp",
    "claude-code",
    "codex",
    "sdk",
    "cli",
    "typescript"
  ],
  "homepage": "https://milesangelo.github.io/neopolitan/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesangelo/neopolitan.git",
    "directory": "packages/neopolitan"
  },
  "bugs": {
    "url": "https://github.com/milesangelo/neopolitan/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "bin": {
    "neopolitan-ai": "./dist/cli.js",
    "neopolitan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "import": "./dist/acp.js",
      "default": "./dist/acp.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js",
      "default": "./dist/claude.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js",
      "default": "./dist/codex.js"
    },
    "./pty": {
      "types": "./dist/pty.d.ts",
      "import": "./dist/pty.js",
      "default": "./dist/pty.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js",
      "default": "./dist/sessions.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration.d.ts",
      "import": "./dist/orchestration.js",
      "default": "./dist/orchestration.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@neopolitan-ai/adapter-acp": "workspace:*",
    "@neopolitan-ai/adapter-claude": "workspace:*",
    "@neopolitan-ai/adapter-codex": "workspace:*",
    "@neopolitan-ai/adapter-pty": "workspace:*",
    "@neopolitan-ai/auth": "workspace:*",
    "@neopolitan-ai/core": "workspace:*",
    "@neopolitan-ai/orchestration": "workspace:*",
    "@neopolitan-ai/runtime-local": "workspace:*",
    "@neopolitan-ai/server": "workspace:*",
    "@neopolitan-ai/sessions": "workspace:*",
    "@neopolitan-ai/workspace": "workspace:*"
  }
}
